# Optional private sandbox configuration. Copy to .env.sandbox for scripts/run-sandbox.mjs.
# Do not reuse production DATABASE_URL or production uploads.
# SANDBOX_INVITE_CODE=choose-a-long-private-invitation-code
# SANDBOX_DATA_DIR=/absolute/private/directory
# SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice

# Optional local AI. Install Ollama and pull this model first.
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# OLLAMA_BIN=/absolute/path/to/ollama
# OLLAMA_MODELS=/absolute/private/model-cache
OLLAMA_NO_CLOUD=1

# Optional separate hosted PostgreSQL; omitted means persistent local PGlite.
# Initial schema setup requires CREATE ROLE and SET ROLE privileges.
# SANDBOX_DATABASE_URL=postgresql://...
# For a future HTTPS deployment only:
# SANDBOX_SECURE_COOKIE=true
# SANDBOX_ORIGINS=https://your-private-demo.example
