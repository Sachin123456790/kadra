  calculationBasis          String    @default("IRR") @map("calculation_basis") // IRR | MULTIPLE
  distributionFrequency     String    @default("QUARTERLY") @map("distribution_frequency") // MONTHLY | QUARTERLY | ANNUAL | MANUAL
  catchUpEnabled            Boolean   @default(false) @map("catch_up_enabled")
