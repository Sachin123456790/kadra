DATABASE_URL=postgresql://your-supabase-pooler-url
PORT=3000
NODE_ENV=development
CHAIN_ID=11155111
CHAIN_RPC_URL=https://rpc.sepolia.org
DEPLOYER_PRIVATE_KEY=your-sepolia-private-key

# Local auth (replaces Supabase Auth). Generate long random strings:
#   openssl rand -base64 48
JWT_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
ADMIN_SIGNUP_SECRET=optional_admin_signup_secret

# AES-256-GCM key for custodial wallet private keys (auto-generated wallets).
# Generate via: openssl rand -base64 32
WALLET_ENCRYPTION_KEY=replace_with_long_random_string

CRON_SERVICE_TOKEN=optional_service_token_for_jobs

# Document extraction provider: mock | gemini
DOCUMENT_PARSER_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
