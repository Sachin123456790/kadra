# ── Testnet RPC ──────────────────────────────────────────────
# Sepolia RPC URL (Alchemy, Infura, or other provider)
# Note: TESTNET_RPC is an alias for SEPOLIA_RPC_URL
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
TESTNET_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# ── Wallet ───────────────────────────────────────────────────
# Private key for testnet wallet (DO NOT use mainnet keys)
DEPLOYER_PRIVATE_KEY=0x_YOUR_TESTNET_PRIVATE_KEY

# Target address for testnet ETH transfer
TRANSFER_TARGET_ADDRESS=0x_TARGET_ADDRESS

# ── Coinbase SDK ─────────────────────────────────────────────
COINBASE_API_KEY_NAME=your_api_key_name
COINBASE_API_KEY_SECRET=your_api_key_secret
CDP_API_KEY_NAME=your_api_key_name
CDP_API_KEY_PRIVATE_KEY=your_api_key_private_key

# ── Legal Entity Simulation ──────────────────────────────────
LEGAL_ENTITY_NAME=Markus Holdings LLC
LEGAL_ENTITY_TAX_ID=EIN-12-3456789
LEGAL_ENTITY_JURISDICTION=US-DE
LEGAL_ENTITY_WALLET_ADDRESS=0x_ENTITY_WALLET_ADDRESS

# ── External Bank Simulation ─────────────────────────────────
BANK_ROUTING_NUMBER=021000021
BANK_ACCOUNT_NUMBER=123456789
BANK_ACCOUNT_HOLDER=Markus Holdings LLC

# ── Coinbase App Data ──────────────────────────────────────
COINBASE_APP_ID=your_coinbase_app_id
COINBASE_APP_SECRET=your_coinbase_app_secret
COINBASE_APP_CLIENT_API_KEY=your_coinbase_client_api_key

# ── SQL Data API ───────────────────────────────────────────
# API key for SQL transaction history endpoint
SQL_API_KEY=your_sql_api_key
# Base URL for SQL data API (leave empty to disable)
SQL_API_ENDPOINT=https://your-sql-api.example.com
